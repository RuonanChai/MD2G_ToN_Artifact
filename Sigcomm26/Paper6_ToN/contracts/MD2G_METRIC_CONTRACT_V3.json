    "units": "unitless [0,1]",
    "when_instrumentation_ready": {
      "may_add": [
        "useful_rendered_bytes / source_bytes",
        "duplicate_bytes",
        "stale_bytes"
      ],
      "require": "MD2G_INSTRUMENTATION_V1 validated + overhead PASS"
    }
  },
  "throughput": {
    "def": "system aggregate Mbps at one agreed boundary per taxonomy",
    "moq_boundary": "root/leaf agreed counters per instrumentation contract",
    "prohibited": "treating lower throughput from failures as efficiency",
    "unicast_boundary": "DASH server egress / per-client HTTP bytes"
  },
