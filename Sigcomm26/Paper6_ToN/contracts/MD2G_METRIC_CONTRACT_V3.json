    "canonical QoE_abs_V2 / U_sys_V3",
    "rank and effect sensitivity table"
  ],
  "name": "MD2G_METRIC_CONTRACT_V3",
  "objective_qoe": {
    "canonical_name": "QoE_abs_V2",
    "constants": {
      "delay_coef": 0.12,
      "intended_duration_s": 120.0,
      "q_min": 0.7,
      "stall_coef": 0.35,
      "stall_severe_ratio": 0.05,
      "ttfb_severe_s": 3.0,
      "u_sys_w_eff": 0.15,
      "u_sys_w_qoe": 0.65,
      "u_sys_w_reuse": 0.2
    },
    "forbidden_aliases": [
      "MOS",
      "subjective user-perceived quality",
      "user study MOS"
    ],
    "formula": "clip(UQ*(1-delay_coef*D)*(1-stall_coef*S)*C, 0, 1)",
    "label": "objective_proxy_QoE",
    "not_mos": true,
    "quality_ladder_Qs": {
      "Q1": 0.4,
      "Q2": 0.6,
      "Q3": 0.8,
      "Q4": 1.0
    },
    "rep_to_Q": {
      "1": 3,
      "2": 2,
      "3": 1,
      "4": 4,
      "5": 4,
      "6": 2,
      "7": 3,
      "8": 1,
      "9": 1
    },
    "source_contract": "contracts/QOE_ABSOLUTE_V2.json"
  },
  "prohibited_interpretations": [
    "objective QoE as MOS",
    "0.7\u00d7RX as useful-byte efficiency",
    "high RX as quality",
    "tie as win",
    "failure-induced low throughput as efficiency"
  ],
  "sensitivity_metrics": {
    "QoE_abs_V2_components": [
      "UQ",
      "D",
      "S",
      "C"
    ],
    "R_final_Eq7_rebuttal": {
      "formula": "R_t = \u03bb_o R_o + \u03bb_q R_q \u2212 \u03bb_b R_b (rebuttal reward_final)",
      "role": "rebuttal sensitivity only; not canonical headline"
    },
    "R_q_Eq9": {
      "alpha": 1.0,
      "beta": 0.5,
      "formula": "R_q = \u03b1\u00b7Q_s \u2212 \u03b2\u00b7D_n \u2212 \u03b3\u00b7S_n",
      "gamma": 0.5,
      "role": "legacy manuscript sensitivity only"
    }
  },
  "stall": {
    "def": "cumulative stall time / intended duration; cumulative must be non-decreasing",
    "denominator": "all launched users"
  },
  "system_utility": {
    "canonical_name": "U_sys_V3",
    "exclude_until_direct_instrumentation": [
      "U_reuse",
      "U_eff",
      "0.7\u00d7RX useful-byte efficiency"
    ],
    "headline_formula": "U_sys_V3 = mean_over_launched_users(QoE_abs_V2)",
    "legacy_U_sys_V2": {
      "formula": "clip(0.65*mean(QoE_abs)+0.20*U_reuse+0.15*U_eff, 0, 1)",
